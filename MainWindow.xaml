<Window x:Class="Soundpad.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="OpenPad" WindowStyle="None" ResizeMode="CanResize" Width="1240" Height="820" MinWidth="1020" MinHeight="720" Foreground="#F2F2EE" Background="#111412" FontFamily="Segoe UI" FontSize="14" AllowDrop="True" Drop="FilesDropped">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#171C18" Height="36">
   <Grid><TextBlock x:Name="VersionLabel" Text="OpenPad" Foreground="#9DA797" FontSize="12" Margin="18,0" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Style="{StaticResource WindowButton}" Content="−" Width="46" Padding="0" ToolTip="{DynamicResource Loc000}" AutomationProperties.Name="{DynamicResource Loc000}" Click="MinimizeWindow"/>
     <Button Style="{StaticResource WindowButton}" x:Name="MaximizeButton" Content="□" Width="46" Padding="0" ToolTip="{DynamicResource Loc001}" AutomationProperties.Name="{DynamicResource Loc001}" Click="MaximizeWindow"/>
     <Button Style="{StaticResource WindowButton}" Content="×" Width="46" Padding="0" ToolTip="{DynamicResource Loc002}" AutomationProperties.Name="{DynamicResource Loc002}" Click="CloseWindow"/>
    </StackPanel>
   </Grid>
  </Border>
 <Grid Margin="28,18,28,18">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="OpenPad /" FontSize="30" FontWeight="Bold"/><TextBlock Text="{DynamicResource Loc003}" Foreground="#939B91" FontSize="10" Margin="2,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="{DynamicResource Loc004}" Click="StopAll" Margin="0,0,12,0"/><Button Content="{DynamicResource Loc005}" Background="{StaticResource Accent}" Foreground="#14200C" Click="Import"/></StackPanel></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
   <ScrollViewer Margin="0,20,18,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="8,11"/></Style></ScrollViewer.Resources><StackPanel><TextBlock Text="{DynamicResource Loc006}" Foreground="#939B91" FontSize="11" Margin="0,0,0,18"/><Button x:Name="AllButton" Content="{DynamicResource Loc007}" Click="ShowAll" HorizontalContentAlignment="Left"/><Button Content="{DynamicResource Loc008}" Click="ShowFavorites" Margin="0,8,0,0"/><TextBlock Text="{DynamicResource Loc112}" Foreground="#939B91" Margin="0,20,0,4"/><ComboBox x:Name="LanguagePicker" SelectionChanged="LanguageChanged" AutomationProperties.Name="Language / Мова / Язык"><ComboBoxItem Content="Українська"/><ComboBoxItem Content="English"/><ComboBoxItem Content="Русский"/></ComboBox><TextBlock Text="{DynamicResource Loc009}" Foreground="#939B91" FontSize="11" Margin="0,24,0,10"/><Button x:Name="SelectionModeButton" Content="{DynamicResource Loc010}" Click="ToggleSelection"/><Button Content="{DynamicResource Loc011}" ToolTip="{DynamicResource Loc012}" Click="SelectVisible" Margin="0,6,0,0"/><TextBlock x:Name="SelectionCount" Text="{DynamicResource Loc013}" Foreground="#A7AFA2" Margin="0,8"/><Button x:Name="DeleteSelectionButton" Content="{DynamicResource Loc014}" ToolTip="{DynamicResource Loc015}" Click="DeleteMarked"/><Button x:Name="UndoRemovalButton" Content="{DynamicResource Loc016}" ToolTip="{DynamicResource Loc017}" Click="UndoRemoval" Margin="0,6,0,0"/><Button Content="{DynamicResource Loc018}" Click="ImportPackage" Margin="0,18,0,0"/><Button x:Name="ExportPackageButton" Content="{DynamicResource Loc019}" Click="ExportPackage" Margin="0,6,0,0"/><TextBlock Text="{DynamicResource Loc020}" Foreground="#939B91" FontSize="11" Margin="0,40,0,12"/><TextBlock Text="Ctrl + Alt + 1…9"/><TextBlock Text="{DynamicResource Loc021}" Foreground="#939B91" TextWrapping="Wrap" Margin="0,8,0,0"/><Button Content="{DynamicResource Loc022}" Click="CreateDemo" Margin="0,28,0,0"/></StackPanel></ScrollViewer><Grid Grid.Column="1" Margin="10,16,24,0"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource Loc023}" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" Foreground="#939B91" Margin="10,9,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button x:Name="TileMode" Content="{DynamicResource Loc024}" Padding="10,8" Click="ShowTiles"/><Button x:Name="ListMode" Content="{DynamicResource Loc025}" Padding="10,8" Margin="6,0,0,0" Click="ShowList"/></StackPanel></Grid><Grid Grid.Row="1" Margin="0,0,0,12"><TextBox x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="{DynamicResource Loc026}" Background="#202521" Foreground="#F2F2EE" BorderThickness="0" Padding="12,8" ToolTip="{DynamicResource Loc027}"/><TextBlock Text="{DynamicResource Loc026}" Margin="12,8" Foreground="#7F8C78" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock x:Name="EmptyLabel" Text="{DynamicResource Loc028}" Foreground="#939B91" FontSize="19" Margin="12,60,12,20" TextWrapping="Wrap"/><WrapPanel x:Name="Tiles"/><StackPanel x:Name="Rows" Visibility="Collapsed"/></StackPanel></ScrollViewer></Grid>
   <Border Grid.Column="2" Background="#1B201C" CornerRadius="12" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="{DynamicResource Loc029}" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="SelectedLabel" Text="{DynamicResource Loc030}" Foreground="#A7AFA2" TextWrapping="Wrap" Margin="0,8,0,20"/>
    <TextBlock x:Name="MasterLabel" Text="{DynamicResource Loc031}"/><Slider x:Name="Master" Maximum="500" Value="100" ValueChanged="SettingsChanged"/>
    <TextBlock x:Name="ClipLabel" Text="{DynamicResource Loc032}"/><Slider x:Name="ClipGain" Maximum="500" Value="100" ValueChanged="ClipChanged"/>
    <TextBlock x:Name="BassLabel" Text="Bass Boost · 0 dB"/><Slider x:Name="Bass" Maximum="24" ValueChanged="ClipChanged"/>
    <ComboBox x:Name="Preset" SelectionChanged="PresetChanged"><ComboBoxItem Content="{DynamicResource Loc033}"/><ComboBoxItem Content="{DynamicResource Loc034}"/><ComboBoxItem Content="{DynamicResource Loc035}"/><ComboBoxItem Content="{DynamicResource Loc036}"/></ComboBox>
    <CheckBox x:Name="Effects" Content="{DynamicResource Loc037}" IsChecked="True" Checked="ClipChanged" Unchecked="ClipChanged"/><CheckBox x:Name="Distort" Content="{DynamicResource Loc038}" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
    <Border Height="1" Background="#343C32" Margin="0,18"/>
    <Button Content="{DynamicResource Loc039}" Click="SetupDiscord" Background="{StaticResource Accent}" Foreground="#14200C" Margin="0,0,0,14"/><TextBlock Text="{DynamicResource Loc040}" FontWeight="SemiBold"/><ComboBox x:Name="Output" DisplayMemberPath="Name" SelectionChanged="RouteChanged"/>
    <TextBlock Text="{DynamicResource Loc041}"/><ComboBox x:Name="Monitor" DisplayMemberPath="Name" SelectionChanged="RouteChanged"/>
    <TextBlock Text="{DynamicResource Loc042}"/><ComboBox x:Name="Microphone" DisplayMemberPath="Name" SelectionChanged="RouteChanged"/><CheckBox x:Name="MicEnabled" Content="{DynamicResource Loc043}" Checked="RouteChanged" Unchecked="RouteChanged"/>
    <TextBlock x:Name="VoiceStatus" Text="{DynamicResource Loc044}" Foreground="#A7AFA2" TextWrapping="Wrap"/><ProgressBar x:Name="MicLevel" Maximum="1" Height="5" Foreground="{StaticResource Accent}" Margin="0,8"/><TextBlock Text="{DynamicResource Loc045}"/><Slider x:Name="VoiceGain" Maximum="200" Value="100" ValueChanged="SettingsChanged"/><Button Content="{DynamicResource Loc046}" Click="RefreshDevices" Margin="0,10,0,0"/>
    <TextBlock Text="{DynamicResource Loc047}" Foreground="#A7AFA2" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="{DynamicResource Loc048}" Foreground="#A7AFA2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Loc049}" FontSize="10" Foreground="#939B91"/><ProgressBar x:Name="Level" Height="5" Maximum="1" Foreground="{StaticResource Accent}" Background="#2A3028" Margin="0,8,0,0"/></StackPanel></Grid>
 </Grid>
</DockPanel></Window>
