<Window x:Class="Soundpad.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="OpenPad" WindowStyle="None" ResizeMode="CanResize" Width="1240" Height="820" MinWidth="1020" MinHeight="720" Foreground="#F2F2EE" Background="#111412" FontFamily="Segoe UI" FontSize="14" AllowDrop="True" Drop="FilesDropped">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#171C18" Height="36">
   <Grid><TextBlock Text="OpenPad" Foreground="#9DA797" FontSize="12" Margin="18,0" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Style="{StaticResource WindowButton}" Content="−" Width="46" Padding="0" ToolTip="Свернуть" AutomationProperties.Name="Свернуть" Click="MinimizeWindow"/>
     <Button Style="{StaticResource WindowButton}" x:Name="MaximizeButton" Content="□" Width="46" Padding="0" ToolTip="Развернуть / восстановить" AutomationProperties.Name="Развернуть / восстановить" Click="MaximizeWindow"/>
     <Button Style="{StaticResource WindowButton}" Content="×" Width="46" Padding="0" ToolTip="Закрыть" AutomationProperties.Name="Закрыть" Click="CloseWindow"/>
    </StackPanel>
   </Grid>
  </Border>
 <Grid Margin="28,18,28,18">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="OpenPad /" FontSize="30" FontWeight="Bold"/><TextBlock Text="ТВОЙ ЗВУК. ТВОЙ МОМЕНТ." Foreground="#939B91" FontSize="10" Margin="2,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="Остановить всё · Ctrl+Alt+0" Click="StopAll" Margin="0,0,12,0"/><Button Content="＋ Добавить звуки" Background="{StaticResource Accent}" Foreground="#14200C" Click="Import"/></StackPanel></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,20,18,0"><TextBlock Text="КОЛЛЕКЦИЯ" Foreground="#939B91" FontSize="11" Margin="0,0,0,18"/><Button x:Name="AllButton" Content="Все звуки" Click="ShowAll" HorizontalContentAlignment="Left"/><Button Content="Избранное" Click="ShowFavorites" Margin="0,8,0,0"/><TextBlock Text="БЫСТРЫЙ ЗАПУСК" Foreground="#939B91" FontSize="11" Margin="0,40,0,12"/><TextBlock Text="Ctrl + Alt + 1…9"/><TextBlock Text="Первые девять звуков&#10;в библиотеке" Foreground="#939B91" TextWrapping="Wrap" Margin="0,8,0,0"/><Button Content="Создать демо-тон" Click="CreateDemo" Margin="0,28,0,0"/></StackPanel>
   <Grid Grid.Column="1" Margin="10,16,24,0"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="Библиотека" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" Foreground="#939B91" Margin="10,9,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button x:Name="TileMode" Content="Плитки" Padding="10,8" Click="ShowTiles"/><Button x:Name="ListMode" Content="Список" Padding="10,8" Margin="6,0,0,0" Click="ShowList"/></StackPanel></Grid><Grid Grid.Row="1" Margin="0,0,0,12"><TextBox x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="Поиск звуков" Background="#202521" Foreground="#F2F2EE" BorderThickness="0" Padding="12,8" ToolTip="Поиск по названию"/><TextBlock Text="Поиск звуков" Margin="12,8" Foreground="#7F8C78" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock x:Name="EmptyLabel" Text="Перетащи сюда аудиофайлы&#10;или нажми «Добавить звуки»." Foreground="#939B91" FontSize="19" Margin="12,60,12,20" TextWrapping="Wrap"/><WrapPanel x:Name="Tiles"/><StackPanel x:Name="Rows" Visibility="Collapsed"/></StackPanel></ScrollViewer></Grid>
   <Border Grid.Column="2" Background="#1B201C" CornerRadius="12" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="Звук и эффекты" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="SelectedLabel" Text="Выбери звук в библиотеке" Foreground="#A7AFA2" TextWrapping="Wrap" Margin="0,8,0,20"/>
    <TextBlock x:Name="MasterLabel" Text="Общая громкость · 100%"/><Slider x:Name="Master" Maximum="500" Value="100" ValueChanged="SettingsChanged"/>
    <TextBlock x:Name="ClipLabel" Text="Громкость клипа · 100%"/><Slider x:Name="ClipGain" Maximum="500" Value="100" ValueChanged="ClipChanged"/>
    <TextBlock x:Name="BassLabel" Text="Bass Boost · 0 dB"/><Slider x:Name="Bass" Maximum="24" ValueChanged="ClipChanged"/>
    <ComboBox x:Name="Preset" SelectionChanged="PresetChanged"><ComboBoxItem Content="Без усиления баса"/><ComboBoxItem Content="Мягкий · +6 dB"/><ComboBoxItem Content="Мощный · +12 dB"/><ComboBoxItem Content="Жёсткий · +20 dB"/></ComboBox>
    <CheckBox x:Name="Effects" Content="Применять Bass Boost" IsChecked="True" Checked="ClipChanged" Unchecked="ClipChanged"/><CheckBox x:Name="Distort" Content="Перегруз" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
    <Border Height="1" Background="#343C32" Margin="0,18"/>
    <Button Content="Настроить голос + звуки" Click="SetupDiscord" Background="{StaticResource Accent}" Foreground="#14200C" Margin="0,0,0,14"/><TextBlock Text="Выход в Discord" FontWeight="SemiBold"/><ComboBox x:Name="Output" DisplayMemberPath="Name" SelectionChanged="RouteChanged"/>
    <TextBlock Text="Наушники / прослушивание"/><ComboBox x:Name="Monitor" DisplayMemberPath="Name" SelectionChanged="RouteChanged"/>
    <TextBlock Text="Микрофон"/><ComboBox x:Name="Microphone" DisplayMemberPath="Name" SelectionChanged="RouteChanged"/><CheckBox x:Name="MicEnabled" Content="Передавать мой голос в Discord" Checked="RouteChanged" Unchecked="RouteChanged"/>
    <TextBlock x:Name="VoiceStatus" Text="Микрофон выключен" Foreground="#A7AFA2" TextWrapping="Wrap"/><ProgressBar x:Name="MicLevel" Maximum="1" Height="5" Foreground="{StaticResource Accent}" Margin="0,8"/><TextBlock Text="Громкость голоса"/><Slider x:Name="VoiceGain" Maximum="200" Value="100" ValueChanged="SettingsChanged"/><Button Content="Обновить устройства" Click="RefreshDevices" Margin="0,10,0,0"/>
    <TextBlock Text="В Discord выбери CABLE Output как устройство ввода. Здесь — CABLE Input. OpenPad должен оставаться открытым, чтобы передавать голос." Foreground="#A7AFA2" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Готов к твоим звукам" Foreground="#A7AFA2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="1"><TextBlock Text="УРОВЕНЬ ВЫХОДА" FontSize="10" Foreground="#939B91"/><ProgressBar x:Name="Level" Height="5" Maximum="1" Foreground="{StaticResource Accent}" Background="#2A3028" Margin="0,8,0,0"/></StackPanel></Grid>
 </Grid>
</DockPanel></Window>
